---
/**
 * Page shell: head basics, liquid-glass filter, header, <main>, footer, motion engine.
 * SEO head (title/meta/canonical/schema from SEO.md) is added per page in phase D/E.
 */
import '../styles/global.css';
import GlassDefs from '../components/ui/GlassDefs.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description?: string; noindex?: boolean }
const { title, description, noindex } = Astro.props;
---
<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#F4F8FD" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex" />}
</head>
<body>
  <GlassDefs />
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <script>import '../scripts/motion/index';</script>
</body>
</html>
