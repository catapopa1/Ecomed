---
/**
 * Page shell: head (title, meta, canonical, Open Graph, JSON-LD per SEO.md §10 / §7), liquid-glass filter,
 * header, <main>, footer, motion engine. Pages pass their own title, description and schema graph.
 */
import '../styles/global.css';
import GlassDefs from '../components/ui/GlassDefs.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description?: string; noindex?: boolean; schema?: Record<string, unknown>[]; ogImage?: string }
const { title, description, noindex, schema, ogImage = '/og/home.jpg' } = Astro.props;   // one share image per page type (SEO.md §10); home's for now
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#F4F8FD" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ro_RO" />
  <meta property="og:site_name" content="Clinica Ecomed - Dr. Alina Teușdea" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Dr. Alina Teușdea by Ecomed: medic de familie și recuperare medicală în Oradea" />
  <meta name="twitter:card" content="summary_large_image" />
  {schema && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schema })} />}
</head>
<body>
  <GlassDefs />
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <script>import '../scripts/motion/index';</script>
</body>
</html>
