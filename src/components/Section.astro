---
/**
 * Section with a ground (light / navy / orange / peach) and a slowly shifting gradient behind it.
 *
 * Technique from the 21st.dev "Gradient Background" (custom-colors demo) that Cata picked on 24 Nov 2026:
 * the whole section is a smooth diagonal two-colour gradient that eases from one palette entry
 * to the next, then loops (the original: framer-motion, 8 s per step, easeInOut).
 * Here it is pure CSS: the gradients are stacked layers that cross-fade, so only opacity
 * animates (composited, no repaint, no JS, no lag).
 *
 * Per section (from `seed`): the angle, which palette entry starts, and the phase all change, so
 * neighbouring sections never look the same. sky-300/sky-500 tones lead; pink appears in the
 * light, peach and navy palettes, only as a gradient colour.
 * Reduced motion: the first gradient, still.
 */
interface Props {
  ground?: 'light' | 'navy' | 'orange' | 'peach';
  seed?: number;
  id?: string;
  class?: string;
  'aria-label'?: string;
  'aria-labelledby'?: string;
}

const { ground = 'light', seed, id, class: cls, ...aria } = Astro.props;

const g = globalThis as { __ecomedSeed?: number };
g.__ecomedSeed = (g.__ecomedSeed ?? 0) + 1;
const s0 = seed ?? g.__ecomedSeed * 7919;

// mulberry32
let t = (s0 * 2654435761) >>> 0;
const rnd = () => {
  t = (t + 0x6d2b79f5) >>> 0;
  let r = Math.imul(t ^ (t >>> 15), 1 | t);
  r ^= r + Math.imul(r ^ (r >>> 7), 61 | r);
  return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
};

// [from, to] pairs, vivid like the reference (Cata: "where are the gradients?").
// Text contrast checked at both ends: navy body text ≥ 5.1:1 on light/peach/orange, white ≥ 4.5:1 on navy.
const palettes: Record<string, [string, string][]> = {
  light: [
    ['#A9CBEE', '#EBBFDA'],   // sky-300 → pink
    ['#C9DDF5', '#8DB4E4'],   // pale sky → deeper sky
    ['#EBBFDA', '#B9C6F0'],   // pink → periwinkle
    ['#FFD9B0', '#A9CBEE'],   // peach → sky-300
    ['#8DB4E4', '#D9E8F8'],   // sky → almost white
  ],
  navy: [
    ['#16243D', '#35649F'],   // deep → sky-500 blue
    ['#2A4774', '#5A4C7E'],   // navy → deep pink
    ['#1B2E4E', '#3D6CA8'],
    ['#3A3F6E', '#16243D'],
  ],
  orange: [
    ['#FFC15E', '#F28C00'],
    ['#FD9E01', '#FFB8A0'],   // orange → pink-peach
    ['#FFA820', '#F07F00'],
  ],
  peach: [
    ['#FFD58A', '#EBBFDA'],   // orange-200 → pink
    ['#F5C9A0', '#A9CBEE'],   // peach → sky-300
    ['#FFEBC7', '#E3A9CC'],
    ['#EBBFDA', '#FFD9B0'],
  ],
};

const pal = palettes[ground];
const N = pal.length;
const start = Math.floor(rnd() * N);
const order = pal.map((_, i) => pal[(start + i) % N]);
const angle = Math.round(110 + rnd() * 70);           // 110–180deg
const step = 9;                                        // seconds per gradient (original: 8)
const phase = -Math.round(rnd() * step * N);
const grad = ([a, b]: [string, string]) => `linear-gradient(${angle}deg, ${a} 0%, ${b} 100%)`;
const layers = order.map((p, i) => `background:${grad(p)};animation-delay:${phase + i * step}s`);
---
<section id={id} class:list={['section', `ground-${ground}`, cls]} data-ground={ground} {...aria}>
  <div class:list={['grad', `n${N}`]} aria-hidden="true" style={`--g-total:${step * N}s;background:${grad(order[0])}`}>
    {layers.map(s => <span style={s}></span>)}
  </div>
  <div class="section-inner"><slot /></div>
</section>

<style>
  .section { position: relative; isolation: isolate; overflow: clip; padding: var(--section-y) var(--gutter); }
  .ground-light { background: var(--ground-light); color: var(--ink); }
  .ground-navy { background: var(--ground-navy); color: var(--ink-on-dark); }
  .ground-orange { background: var(--ground-orange); color: var(--color-navy-900); }
  .ground-peach { background: var(--ground-peach); color: var(--ink); }

  .section-inner { position: relative; z-index: 1; }

  .grad {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
  }
  /* each layer (one step apart): eases in for one step, holds one step, eases out for one step.
     The next layer comes in on top while this one holds, so the change is always a smooth cross-fade. */
  .grad span { position: absolute; inset: 0; opacity: 0; animation: var(--g-anim) var(--g-total) ease-in-out infinite; }
  .n3 { --g-anim: grad3; }
  .n4 { --g-anim: grad4; }
  .n5 { --g-anim: grad5; }
  @keyframes grad3 { 0% { opacity: 0; } 33.333% { opacity: 1; } 66.667% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes grad4 { 0% { opacity: 0; } 25% { opacity: 1; } 50% { opacity: 1; } 75%, 100% { opacity: 0; } }
  @keyframes grad5 { 0% { opacity: 0; } 20% { opacity: 1; } 40% { opacity: 1; } 60%, 100% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .grad span { animation: none; }
  }
</style>
