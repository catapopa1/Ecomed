---
/**
 * D1 test board (/dev/d/): the home order Cata set on 25 Nov 2026, as section outlines, inside the
 * stage, with a different scroll transition at every boundary so he can pick per boundary.
 * Order: Hero → Servicii → Vouchere → Video → Echipa → Recomandări → Program și locație.
 * Copy here is only what FACTS already says; headings are drafts (D4 writes the copy).
 * Photos, voucher fronts and the video are placeholders (T2, T10; media stays outside the repo for now).
 */
import Section from '../Section.astro';
import Hero from '../home/Hero.astro';
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';
import { GROUPS } from '../../data/vouchers';

const services = [
  { icon: 'stethoscope', t: 'Medicină de familie', d: 'Adulți și copii: consultații, controale periodice și prevenție.', href: '/medicina-de-familie/', c: '#7FB0EC' },
  { icon: 'movement', t: 'Kinetoterapie și recuperare', d: 'Recuperare medicală, la clinică și la domiciliu.', href: '/kinetoterapie/', c: '#FFB547' },
  { icon: 'sparkles', t: 'Terapii beauty', d: 'Pentru corp și față, fără ace și fără bisturiu.', href: '/terapii-beauty/', c: '#FF9C7E' },
] as const;
/* one colour per recommendation (brand sky / orange / peach tones; no mauve outside gradients) */
const recColors = ['#5E93D6', '#F5A02A', '#FF8F70', '#7FB8E8', '#FFC861'];
const extra = ['Ecografie', 'EKG', 'Holter TA', 'Osteodensitometrie'];
const staff = [
  { n: 'Dr. Teușdea Alina', r: 'Medic primar Medicină de familie · Competență în ecografie generală' },
  { n: 'Dr. Baiduca Alexandru', r: 'Medic specialist Medicină fizică și de reabilitare' },
  { n: 'Bodogai Anca', r: 'Fiziokinetoterapeut · Kinetoterapie la clinică și la domiciliu' },
  { n: 'Gelnic Corina Maria', r: 'Asistent medical generalist · Balneofiziokinetoterapeut' },
];
const quotes = [
  'Prevenția nu este pentru cei bolnavi, ci pentru cei care vor să rămână sănătoși, la orice vârstă.',
  'Nu așteptați să vă doară ca să veniți la control.',
  'Peste 40 de ani? Este momentul potrivit pentru verificarea tensiunii, glicemiei și colesterolului.',
  'Vă cunoaștem, vă urmărim în timp și vă coordonăm îngrijirea.',
  'Nu știți dacă aveți nevoie de specialist sau de analize? Începeți cu medicul de familie.',
];
---
<div class="tx-legend liquid" aria-hidden="true">D1 · tranziții: zoom-slide → cerc → portal → jaluzele → cub → diagonală</div>

<div data-stage>
  <div class="scene"><Hero /></div>

  <!-- 1 → 2: zoom out, slide sideways, zoom in (Cata's idea) -->
  <div class="scene" data-tx="zoomslide">
    <Section ground="navy" seed={202} aria-labelledby="h-serv">
      <SectionHead eyebrow="Servicii" title="Cele trei servicii ale clinicii" size="h1"><p>(text în pasul D4)</p></SectionHead>
      <div class="svc">
        {services.map((s) => (
          <a class="svc-card liquid" href={s.href} style={`--c:${s.c}`}>
            <span class="svc-ic"><Icon name={s.icon} size="2.6rem" stroke={1.8} /></span>
            <h3>{s.t}</h3><p>{s.d}</p>
          </a>
        ))}
      </div>
      <p class="extra">Servicii suplimentare: {extra.join(' · ')}</p>
    </Section>
  </div>

  <!-- 2 → 3: a circle opens; inside, the vouchers scroll sideways -->
  <div class="scene" data-tx="iris">
    <Section ground="peach" seed={203}>
      <SectionHead eyebrow="Vouchere" title="Pentru dumneavoastră sau cadou" />
      <div class="hview">
        <div class="htrack" data-htrack>
          {GROUPS.map((g) => (
            <a class="vg liquid" href={g.slug}>
              <span class="vg-front">fronturile reale ale voucherelor</span>
              <span class="vg-n">{g.order} / 7</span>
              <h3>{g.title}</h3><p>{g.hook}</p>
            </a>
          ))}
        </div>
      </div>
      <div class="center"><Button variant="primary" href="/vouchere/" iconEnd="arrow">Toate voucherele</Button></div>
    </Section>
  </div>

  <!-- 3 → 4: a window opens in the middle and we fly through it -->
  <div class="scene" data-tx="portal" data-no-header>
    <Section ground="navy" seed={204} class="video-sec">
      <div class="video">
        <div class="video-frame"><span>Video (T2: care video?)</span></div>
      </div>
    </Section>
  </div>

  <!-- 4 → 5: vertical blinds -->
  <div class="scene" data-tx="blinds">
    <Section ground="light" seed={205}>
      <SectionHead eyebrow="Echipa noastră" title="Medici și terapeuți specializați" />
      <div class="team">
        {staff.map((p) => (
          <article class="person liquid">
            <div class="ph">foto (T10)</div>
            <h3>{p.n}</h3><p>{p.r}</p>
          </article>
        ))}
      </div>
      <div class="center"><Button variant="secondary" href="/despre-noi/" iconEnd="arrow">Despre noi</Button></div>
    </Section>
  </div>

  <!-- 5 → 6: the stage turns like a cube; the quotes then step through -->
  <div class="scene" data-tx="cube">
    <Section ground="navy" seed={206}>
      <SectionHead eyebrow="Recomandările noastre" title="Pe scurt, de la medicul de familie" />
      <div class="rec" data-rec>
        <div class="rec-wash" aria-hidden="true">{quotes.map((_, i) => <i style={`--c:${recColors[i]}`}></i>)}</div>
        <div class="rec-cards">
          {quotes.map((q, i) => <blockquote class="q" style={`--c:${recColors[i]}`}><span class="q-n">{i + 1} / {quotes.length}</span><p>„{q}”</p></blockquote>)}
        </div>
        <button type="button" class="rec-skip" data-down="Treceți peste recomandări" data-up="Înapoi, peste recomandări">
          <span class="lbl">Treceți peste recomandări</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <div class="center"><Button variant="call" /></div>
    </Section>
  </div>

  <!-- 6 → 7: a diagonal wipe sweeps across -->
  <div class="scene" data-tx="diagonal">
    <Section ground="peach" seed={207}>
      <SectionHead eyebrow="Program și locație" title="Vă așteptăm la clinică" />
      <div class="visit">
        <div class="hours liquid">
          {site.hours.map((h) => <p><strong>{h.days}</strong><span>{h.time}</span></p>)}
          <p class="note">{site.hoursNote}</p>
        </div>
        <a class="map liquid" href={site.mapsHref}><span>hartă (statică, link spre Google Maps)</span><strong>{site.street}, {site.city}</strong></a>
      </div>
      <div class="center btns"><Button variant="call" size="lg" /><Button variant="secondary" size="lg" href="/contact/" iconEnd="arrow">Contact</Button></div>
    </Section>
  </div>
</div>

<style>
  .tx-legend { position: fixed; left: 50%; bottom: 1rem; transform: translateX(-50%); z-index: 90; padding: 0.4rem 0.9rem; border-radius: 99px; font-size: 0.8rem; color: var(--color-navy-900); --lg-fill: rgb(255 255 255 / 0.7); }
  .center { display: flex; justify-content: center; margin-top: 1.8rem; }
  .btns { gap: 0.8rem; flex-wrap: wrap; }
  h3 { margin: 0; font-size: var(--text-h3, 1.4rem); font-weight: 600; }
  .svc, .team, .visit, .rec, .hview, .video { max-width: var(--container-page); margin: 1.8rem auto 0; }

  .svc { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; margin-top: 2.4rem; }
  .svc-card {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1rem; padding: 2.4rem 2rem 2.6rem;
    border-radius: 1.8rem; color: inherit; text-decoration: none;
    --lg-fill: color-mix(in srgb, var(--c) 24%, rgb(255 255 255 / 0.06));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 55%, transparent), 0 1.4rem 3rem -1.6rem color-mix(in srgb, var(--c) 70%, black);
  }
  .svc-ic {
    display: grid; place-items: center; width: 5.4rem; height: 5.4rem; border-radius: 50%;
    background: var(--c); color: var(--color-navy-900);
    box-shadow: 0 0.9rem 2rem -0.8rem var(--c), inset 0 1px 0 rgb(255 255 255 / 0.65);
  }
  .svc-card h3 { font-size: 1.9rem; line-height: 1.2; }
  .svc-card p { margin: 0; font-size: 1.2rem; line-height: 1.5; color: var(--ctx-muted); max-width: 22rem; }
  .person p, .vg p { margin: 0; color: var(--ctx-muted); }
  .extra { text-align: center; margin: 2rem 0 0; color: var(--ctx-muted); font-size: 1.1rem; }

  .hview { overflow: visible; max-width: none; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
  .htrack { display: flex; gap: 1.4rem; width: max-content; }
  .vg { width: 22rem; display: grid; gap: 0.6rem; padding: 1.2rem 1.2rem 1.6rem; border-radius: 1.6rem; color: inherit; text-decoration: none; }
  .vg-front { aspect-ratio: 3 / 2; border-radius: 1rem; display: grid; place-items: center; font-size: 0.85rem; color: var(--ctx-muted); background: rgb(255 255 255 / 0.45); border: 1px dashed rgb(22 36 61 / 0.3); }
  .vg-n { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; }

  /* the video fills the whole screen; the header hides over it (Cata) */
  :global(.video-sec.section) { padding: 0 !important; }
  .video { max-width: none; margin: 0; }
  .video-frame { width: 100%; height: 100vh; height: 100svh; display: grid; place-items: center; background: linear-gradient(135deg, #2A4774, #5A4C7E); color: var(--color-sky-300); }

  .team { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
  .person { padding: 1rem 1rem 1.4rem; border-radius: 1.6rem; display: grid; gap: 0.5rem; }
  .ph { aspect-ratio: 4 / 5; border-radius: 1.1rem; display: grid; place-items: center; background: rgb(255 255 255 / 0.4); border: 1px dashed rgb(22 36 61 / 0.3); color: var(--ctx-muted); font-size: 0.85rem; }

  /* recommendations: one card at a time, each growing out of its point on the line below */
  .rec { position: relative; max-width: none; }
  .rec-wash { position: absolute; inset: -40vh -10vw; pointer-events: none; z-index: 0; }
  .rec-wash i { position: absolute; inset: 0; opacity: 0; background: radial-gradient(42% 46% at 50% 45%, color-mix(in srgb, var(--c) 34%, transparent), transparent 70%); }
  .rec-wash i:first-child { opacity: 1; }
  .rec-cards { position: relative; z-index: 3; display: grid; justify-items: center; max-width: 44rem; margin: 0 auto; }
  .q {
    grid-area: 1 / 1; width: 100%; margin: 0; padding: 2.4rem 3rem 2.6rem; border-radius: 2rem; text-align: center;
    background: color-mix(in srgb, var(--c) 26%, rgb(255 255 255 / 0.06));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 60%, transparent), 0 1.6rem 3.4rem -1.8rem color-mix(in srgb, var(--c) 80%, black);
    transform-origin: 50% 100%; backface-visibility: hidden;
  }
  .q-n { display: block; margin-bottom: 0.8rem; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; color: var(--c); }
  .q p { margin: 0; font-size: var(--text-h2); line-height: 1.25; font-weight: 500; text-wrap: balance; }
  /* skip: down (arrived from above) or up (arrived from below) */
  .rec-skip { position: relative; display: flex; margin: 1.4rem auto 0; width: max-content; z-index: 2; align-items: center; gap: 0.5rem;
    padding: 0.55rem 0.95rem; border: 0; border-radius: 999px; font: inherit; font-size: 0.9rem; font-weight: 500; cursor: pointer;
    color: rgb(255 255 255 / 0.82); background: rgb(255 255 255 / 0.08); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
    transition: background-color 180ms, color 180ms, transform 120ms; touch-action: manipulation; }
  .rec-skip svg { width: 1.05rem; height: 1.05rem; transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .rec-skip.up svg { transform: rotate(180deg); }
  .rec-skip:active { transform: scale(0.97); }
  .rec-skip:focus-visible { outline: 2px solid var(--color-sky-300, #9cc8f0); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) { .rec-skip:hover { background: rgb(255 255 255 / 0.16); color: #fff; } }

  .visit { display: grid; grid-template-columns: 1fr 1.3fr; gap: 1.4rem; max-width: 64rem; }
  .hours { padding: 2rem; border-radius: 1.6rem; }
  .hours p { display: flex; justify-content: space-between; gap: 1rem; margin: 0 0 0.8rem; }
  .hours .note { margin: 1.4rem 0 0; color: var(--ctx-muted); }
  .map { min-height: 14rem; border-radius: 1.6rem; display: grid; place-items: center; align-content: center; gap: 0.6rem; padding: 2rem; color: inherit; text-decoration: none; text-align: center; }
  .map span { font-size: 0.85rem; color: var(--ctx-muted); }

  @media (max-width: 820px) {
    .svc, .team, .visit { grid-template-columns: 1fr; }
    .team { grid-template-columns: 1fr 1fr; }
    .vg { width: 78vw; }
    .q { padding: 1.6rem; }
    .q p { font-size: 1.4rem; }
  }
</style>
