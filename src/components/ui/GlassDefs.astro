---
/**
 * Once per page (in the layout): the SVG filter that makes liquid glass bend what is behind it.
 * Same idea as the Nimbus "Liquid Glass Navbar" (MIT): soft fractal noise → displacement.
 * Only Chromium supports an SVG filter inside backdrop-filter, so the script turns it on there
 * (html[data-refract]); every other browser keeps the plain blur.
 */
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <filter id="lg-refract" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.006 0.02" numOctaves="2" seed="7" result="noise" />
    <feGaussianBlur in="noise" stdDeviation="2" result="soft" />
    <feDisplacementMap in="SourceGraphic" in2="soft" scale="40" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>
<script is:inline>
  (function () {
    var ua = navigator.userAgent;
    if (/Chrome\/|Chromium\/|Edg\//.test(ua) && !/Firefox\//.test(ua) && window.CSS && CSS.supports('backdrop-filter', 'url(#a)'))
      document.documentElement.setAttribute('data-refract', '');
  })();
</script>
