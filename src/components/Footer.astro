---
/**
 * Site footer (C2, Cata 24 Nov). One footer for phone and desktop, a full screen of its own,
 * everything centred (the popa-insolventa footer): name, lead, call + e-mail, Program / social /
 * Adresă, the by-appointment note, pages, copyright + back to top.
 *  - phone: approved by Cata 24 Nov (one column, Program | Adresă side by side, big socials);
 *  - desktop: the same pieces on a wider grid, three cards across, and "Dr. Alina Teușdea" nearly
 *    edge to edge at the bottom, sunk into the edge with a slow light crossing it (the Chromify
 *    footer). Desktop only.
 * Lists from src/data/nav.ts; NAP strings exactly as SEO.md §8.
 */
import Section from './Section.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import { site } from '../data/site';
import { TOP, LEGAL } from '../data/nav';

const year = new Date().getFullYear();
const links = [...TOP, { href: '/blog/', label: 'Blog' }];
---
<footer class="site-footer">
  <Section ground="navy" seed={9001} class="foot" aria-label="Subsol">
    <div class="fp">
      <div class="fp-main">
        <a class="fp-brand" href="/" aria-label={`${site.name}, Acasă`}>
          <span class="fp-name">{site.brand}</span>
          <span class="fp-sub">{site.brandSub}</span>
        </a>
        <p class="fp-lead">Medicină de familie, kinetoterapie și terapii beauty în Oradea.</p>
        <div class="fp-cta">
          <Button variant="call" />
          <Button variant="secondary" icon="mail" href={`mailto:${site.email}`}>E-mail</Button>
        </div>
        <div class="fp-grid">
          <div class="fp-col">
            <span class="fp-label">Program</span>
            {site.hours.map((h) => <span class="fp-h">{h.days}<b>{h.time}</b></span>)}
          </div>
          <address class="fp-col">
            <span class="fp-label">Adresă</span>
            <span>{site.street}</span>
            <span>{site.city}</span>
            <a class="fp-map" href={site.mapsHref} target="_blank" rel="noopener">Vezi pe hartă <Icon name="arrow" size="0.95rem" stroke={2} /></a>
          </address>
        </div>
        <p class="fp-note"><Icon name="calendar" size="1.1rem" stroke={2} />{site.hoursNote}</p>
        <nav class="fp-links" aria-label="Pagini">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <ul class="fp-soc" aria-label="Rețele sociale">
          {site.socials.map((x) => <li><a href={x.href} target="_blank" rel="noopener"><span class="fp-si"><Icon name={x.icon} size="1.7rem" stroke={1.9} /></span><span class="fp-sn">{x.name}</span></a></li>)}
        </ul>
      </div>
      <div class="fp-bot">
        <div class="fp-bot-t">
          <p>© {year} {site.legal}</p>
          <p>{LEGAL.map((l) => <a href={l.href}>{l.label}</a>)}</p>
        </div>
        <a class="fp-top" href="#main" aria-label="Înapoi sus" data-to-top><Icon name="arrow" size="1.2rem" stroke={2.2} /></a>
      </div>
      <p class="fp-word" aria-hidden="true">{site.brand}</p>
    </div>
  </Section>
</footer>

<script>
  import { getLenis } from '../scripts/motion/smooth';
  document.querySelectorAll<HTMLAnchorElement>('[data-to-top]').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    const l = getLenis();
    if (l) l.scrollTo(0); else window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }));
</script>

<style>
  ul { list-style: none; margin: 0; padding: 0; }
  .site-footer :global(.foot > .section-inner) { flex: 1; display: flex; }
  .fp-word { display: none; }

  /* ── phone: one screen, everything centred (popa-insolventa), the wordmark at the bottom (Chromify) ── */
  @media (max-width: 820px) {
    .site-footer :global(.foot) { min-height: 100svh; display: flex; padding: calc(1.6rem + env(safe-area-inset-top, 0px)) var(--gutter) 0; }
    .fp { flex: 1; display: flex; flex-direction: column; text-align: center; color: var(--color-white); }
    .fp-main { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; align-items: center; gap: 1.3rem; padding-bottom: 1.4rem; }

    .fp-brand { display: grid; justify-items: center; gap: 0.35rem; color: inherit; text-decoration: none; line-height: 1; }
    .fp-name { font-size: 2.3rem; font-weight: 700; letter-spacing: -0.025em; }
    .fp-sub { font-size: 1rem; font-weight: 500; color: var(--color-sky-300); }
    .fp-lead { margin: -0.4rem 0 0; max-width: 22rem; font-size: 1.08rem; line-height: 1.5; color: var(--ink-on-dark-soft); text-wrap: balance; }

    .fp-cta { display: flex; gap: 0.6rem; width: 100%; }
    .fp-cta :global(.btn) { flex: 1; padding-inline: 0.8rem; }
    .fp-cta :global(.btn-call) { --lg-fill: linear-gradient(180deg, var(--color-orange-200), var(--color-orange) 55%); --lg-bright: 1; --lg-sat: 1; }

    .fp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; width: 100%; }
    .fp-col { display: grid; align-content: start; justify-items: center; gap: 0.25rem; font-style: normal; font-size: 0.98rem; line-height: 1.35; color: var(--ink-on-dark-soft); }
    .fp-label { margin-bottom: 0.3rem; font-size: var(--text-eyebrow); letter-spacing: var(--text-eyebrow--letter-spacing); text-transform: uppercase; font-weight: 700; color: var(--color-sky-300); }
    .fp-h { display: grid; gap: 0.05rem; }
    .fp-h + .fp-h { margin-top: 0.3rem; }
    .fp-h b { font-size: 1.15rem; font-weight: 700; color: var(--color-orange); font-variant-numeric: tabular-nums; }
    .fp-map { display: inline-flex; align-items: center; gap: 0.3rem; min-height: 44px; font-weight: 600; color: var(--color-orange); text-decoration: none; }

    .fp-links { display: grid; grid-template-columns: repeat(3, 1fr); justify-items: center; width: 100%; }
    .fp-links a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 500; font-size: 1.02rem; color: var(--color-white); text-decoration: none; }

    .fp-note { display: inline-flex; align-items: center; gap: 0.5rem; margin: -0.4rem 0 0; padding: 0.55rem 1.1rem; border-radius: var(--radius-pill);
      font-size: 0.95rem; font-weight: 500; color: var(--color-white); background: rgb(253 158 1 / 0.14); box-shadow: inset 0 0 0 1px rgb(253 158 1 / 0.4); }
    .fp-note :global(.icon) { color: var(--color-orange); flex: none; }

    /* social buttons: big, named, spaced out (promoting the profiles, Cata) */
    .fp-soc { display: flex; justify-content: center; gap: 2rem; }
    .fp-soc a { display: grid; justify-items: center; gap: 0.5rem; color: var(--color-white); text-decoration: none; font-size: 0.9rem; font-weight: 500; }
    .fp-si { display: grid; place-items: center; width: 4.4rem; height: 4.4rem; border-radius: 50%;
      background: linear-gradient(145deg, var(--color-sky-300), var(--color-sky-500)); color: var(--color-navy-900);
      box-shadow: 0 0.7rem 1.6rem -0.6rem rgb(94 147 214 / 0.85), inset 0 1px 0 rgb(255 255 255 / 0.6); transition: transform 160ms var(--ease-out); }
    .fp-soc a:active .fp-si { transform: scale(0.94); }

    .fp a { touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
    .fp-links a:active, .fp-map:active, .fp-bot a:active { opacity: 0.7; }

    .fp-bot { display: flex; align-items: center; gap: 1rem; padding: 0.9rem 0 calc(1rem + env(safe-area-inset-bottom, 0px)); border-top: 1px solid rgb(255 255 255 / 0.12);
      font-size: 0.8rem; color: var(--ink-on-dark-soft); text-align: left; }
    .fp-bot-t { flex: 1; display: grid; gap: 0.1rem; }
    .fp-bot p { margin: 0; }
    .fp-bot p:last-child { display: flex; flex-wrap: wrap; gap: 0 1rem; }
    .fp-bot-t a { display: inline-flex; align-items: center; min-height: 36px; color: inherit; text-decoration: none; }
    .fp-top { display: grid; place-items: center; flex: none; width: 3rem; height: 3rem; min-width: 44px; min-height: 44px; border-radius: 50%;
      background: rgb(255 255 255 / 0.1); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.2); color: var(--color-white); }
    .fp-top :global(.icon) { transform: rotate(-90deg); }
  }

  /* ── desktop: the phone footer, widened (popa-insolventa), the name sunk at the bottom (Chromify) ── */
  @media (min-width: 821px) {
    .site-footer :global(.foot) { min-height: 100vh; min-height: 100svh; display: flex; padding: 2.4rem var(--gutter) 0; }
    .fp { flex: 1; display: flex; flex-direction: column; width: 100%; max-width: var(--container-page); margin: 0 auto; text-align: center; color: var(--color-white); }
    .fp-main {
      flex: 1; width: 100%; max-width: 68rem; margin: 0 auto; padding-bottom: 1rem;
      display: grid; grid-template-columns: 1fr 1fr 1fr; justify-items: center; align-content: space-evenly; column-gap: 1.2rem; row-gap: 1.1rem;
      grid-template-areas: 'brand brand brand' 'lead lead lead' 'cta cta cta' 'prog soc addr' 'note note note' 'links links links';
    }
    .fp-brand { grid-area: brand; display: grid; justify-items: center; gap: 0.45rem; color: inherit; text-decoration: none; line-height: 1; }
    .fp-name { font-size: 3.6rem; font-weight: 700; letter-spacing: -0.03em; }
    .fp-sub { font-size: 1.2rem; font-weight: 500; color: var(--color-sky-300); }
    .fp-lead { grid-area: lead; margin: -0.5rem 0 0; font-size: 1.2rem; color: var(--ink-on-dark-soft); }
    .fp-cta { grid-area: cta; display: flex; gap: 0.8rem; }
    .fp-cta :global(.btn) { min-width: 13rem; }
    .fp-cta :global(.btn-call) { --lg-fill: linear-gradient(180deg, var(--color-orange-200), var(--color-orange) 55%); --lg-bright: 1; --lg-sat: 1; }

    /* the three cards across: Program, social, Adresă */
    .fp-grid { display: contents; }
    .fp-grid > :first-child { grid-area: prog; }
    .fp-grid > address { grid-area: addr; }
    .fp-col, .fp-soc {
      width: 100%; height: 100%; padding: 1.1rem 1.2rem; border-radius: var(--radius-lg);
      background: rgb(169 203 238 / 0.08); box-shadow: inset 0 0 0 1px rgb(169 203 238 / 0.2), 0 1.4rem 2.6rem -1.6rem rgb(0 0 0 / 0.5);
    }
    .fp-col { display: grid; align-content: center; justify-items: center; gap: 0.25rem; font-style: normal; font-size: 1.05rem; line-height: 1.4; color: var(--ink-on-dark-soft); }
    .fp-label { margin-bottom: 0.4rem; font-size: var(--text-eyebrow); letter-spacing: var(--text-eyebrow--letter-spacing); text-transform: uppercase; font-weight: 700; color: var(--color-sky-300); }
    .fp-h { display: grid; gap: 0.05rem; }
    .fp-h + .fp-h { margin-top: 0.4rem; }
    .fp-h b { font-size: 1.4rem; font-weight: 700; color: var(--color-orange); font-variant-numeric: tabular-nums; }
    .fp-map { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.4rem; font-weight: 600; color: var(--color-orange); text-decoration: none; }

    .fp-soc { grid-area: soc; display: flex; justify-content: center; align-items: center; gap: 1.8rem; }
    .fp-soc a { display: grid; justify-items: center; gap: 0.55rem; color: var(--color-white); text-decoration: none; font-size: 0.95rem; font-weight: 500; }
    .fp-si { display: grid; place-items: center; width: 4.6rem; height: 4.6rem; border-radius: 50%;
      background: linear-gradient(145deg, var(--color-sky-300), var(--color-sky-500)); color: var(--color-navy-900);
      box-shadow: 0 0.7rem 1.6rem -0.6rem rgb(94 147 214 / 0.85), inset 0 1px 0 rgb(255 255 255 / 0.6);
      transition: transform 200ms var(--ease-out), background-color 200ms var(--ease-out); }

    .fp-note { grid-area: note; display: inline-flex; align-items: center; gap: 0.55rem; margin: 0; padding: 0.6rem 1.3rem; border-radius: var(--radius-pill);
      font-size: 1rem; font-weight: 500; background: rgb(253 158 1 / 0.14); box-shadow: inset 0 0 0 1px rgb(253 158 1 / 0.4); }
    .fp-note :global(.icon) { color: var(--color-orange); }

    .fp-links { grid-area: links; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.2rem 2.4rem; }
    .fp-links a { display: inline-flex; align-items: center; min-height: 2.6rem; font-weight: 500; font-size: 1.08rem; color: var(--color-white); text-decoration: none; transition: color 200ms var(--ease-out); }

    .fp-bot { display: flex; align-items: center; gap: 1.5rem; padding: 1rem 0; border-top: 1px solid rgb(255 255 255 / 0.12); font-size: var(--text-small); color: var(--ink-on-dark-soft); }
    .fp-bot-t { flex: 1; display: flex; justify-content: space-between; align-items: center; gap: 1rem 2rem; flex-wrap: wrap; }
    .fp-bot p { margin: 0; }
    .fp-bot p:last-child { display: flex; gap: 1.6rem; }
    .fp-bot-t a { color: inherit; text-decoration: none; transition: color 200ms var(--ease-out); }
    .fp-top { display: grid; place-items: center; flex: none; width: 2.8rem; height: 2.8rem; border-radius: 50%;
      background: rgb(255 255 255 / 0.1); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.2); color: var(--color-white); transition: background-color 200ms var(--ease-out), color 200ms var(--ease-out); }
    .fp-top :global(.icon) { transform: rotate(-90deg); }

    /* the name, nearly edge to edge, sunk into the bottom edge; a slow light crosses it (Chromify) */
    .fp-word {
      display: block; margin: 0.2rem calc(50% - 50vw) -0.24em; text-align: center; font-size: calc((100vw - 4rem) / 8.1);   /* the name is 8.09em wide in Rubik 800 at this tracking; centred on the window, not the content column (27" screens) */ font-weight: 800; line-height: 1;
      letter-spacing: -0.035em; white-space: nowrap; user-select: none; -webkit-user-select: none;
      background-image: linear-gradient(100deg, transparent 40%, rgb(255 255 255 / 0.75) 50%, transparent 60%),
                        linear-gradient(180deg, var(--color-orange-200) 0%, var(--color-sky-300) 40%, var(--color-sky-500) 100%);
      background-size: 300% 100%, 100% 100%; background-position: 150% 0, 0 0;
      -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent;
      -webkit-mask-image: linear-gradient(180deg, #000 40%, transparent 100%); mask-image: linear-gradient(180deg, #000 40%, transparent 100%);
    }
    @media (prefers-reduced-motion: no-preference) { .fp-word { animation: fp-sheen 9s var(--ease-in-out) infinite; } }
    @keyframes fp-sheen { 0%, 30% { background-position: 150% 0, 0 0; } 100% { background-position: -50% 0, 0 0; } }

    @media (hover: hover) and (pointer: fine) {
      .fp-links a:hover, .fp-bot-t a:hover, .fp-map:hover { color: var(--color-orange-200); }
      .fp-soc a:hover .fp-si { transform: translateY(-3px); }
      .fp-top:hover { background: var(--color-orange); color: var(--color-navy-900); }
    }
  }
</style>
