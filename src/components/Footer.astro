---
/**
 * Site footer (C2, desktop v3, Cata 24 Nov): exactly one screen tall, so at the bottom of a page
 * only the footer shows (no leftover of the last section); navy only (no orange band); the four
 * cards stretch to fill the space, and every entry sits on a darker tile so the cards are full.
 *
 *   ┌ navy, 100svh ──────────────────────────────────────────────────────────┐
 *   │ (space under the floating header)                                       │
 *   │       Dr. Alina Teușdea by Ecomed · lead · call + email · pages         │
 *   │  [Servicii] [Vouchere cadou ×2 cols] [Program] [Urmăriți-ne]  ← stretch │
 *   │  © … · legal                                                            │
 *   └─────────────────────────────────────────────────────────────────────────┘
 * Phone layout to be designed with Cata later; until then it stacks.
 * Lists from src/data/nav.ts; NAP strings exactly as SEO.md §8.
 */
import Section from './Section.astro';
import Button from './ui/Button.astro';
import Icon, { type IconName } from './ui/Icon.astro';
import { site } from '../data/site';
import { TOP, MAIN_SERVICES, VOUCHER_GROUPS, LEGAL } from '../data/nav';

const year = new Date().getFullYear();
const svcIcons: IconName[] = ['stethoscope', 'movement', 'sparkles'];
const links = [...TOP, { href: '/blog/', label: 'Blog' }];
---
<footer class="site-footer">
  <Section ground="navy" seed={9001} class="foot" aria-label="Subsol">
    <div class="frame">
      <div class="head">
        <a class="brand" href="/" aria-label={`${site.name}, Acasă`}>
          <span class="brand-name">{site.brand}</span>
          <span class="brand-sub">{site.brandSub}</span>
        </a>
        <p class="lead">Medicină de familie, kinetoterapie și terapii beauty în Oradea.</p>
        <div class="row">
          <div class="cta">
            <Button variant="call" />
            <Button variant="secondary" icon="mail" href={`mailto:${site.email}`}>{site.email}</Button>
          </div>
          <span class="sep" aria-hidden="true"></span>
          <nav class="links" aria-label="Pagini">
            <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </nav>
        </div>
      </div>

      <div class="cards">
        <nav class="card liquid svc-card" aria-label="Servicii">
          <h2><span class="disc"><Icon name="heart-pulse" size="1.1rem" stroke={2} /></span>Servicii</h2>
          <ul class="tiles">
            {MAIN_SERVICES.map((s, i) => (
              <li><a class="tile" href={s.href}><span class="ti"><Icon name={svcIcons[i]} size="1.1rem" /></span><span class="tt">{s.short ?? s.label}</span></a></li>
            ))}
            <li><a class="tile all" href="/servicii/"><span class="tt">Toate serviciile</span><Icon name="arrow" size="1rem" stroke={2} /></a></li>
          </ul>
        </nav>

        <nav class="card liquid" aria-label="Vouchere cadou">
          <h2><span class="disc"><Icon name="gift" size="1.1rem" stroke={2} /></span>Vouchere cadou</h2>
          <ul class="tiles two">
            {VOUCHER_GROUPS.map((g, i) => (
              <li><a class="tile" href={g.href}><span class="num">{i + 1}</span><span class="tt">{g.label}</span></a></li>
            ))}
            <li><a class="tile all" href="/vouchere/"><span class="tt">Toate voucherele</span><Icon name="arrow" size="1rem" stroke={2} /></a></li>
          </ul>
        </nav>

        <div class="card liquid">
          <h2><span class="disc"><Icon name="clock" size="1.1rem" stroke={2} /></span>Program</h2>
          <ul class="tiles">
            {site.hours.map((h) => (
              <li><div class="tile col"><span class="days">{h.days}</span><b class="time">{h.time}</b></div></li>
            ))}
            <li><div class="tile col"><span class="days">{site.hoursNote}</span></div></li>
            <li><address class="addr-wrap"><a class="tile" href={site.mapsHref} target="_blank" rel="noopener">
              <span class="ti orange"><Icon name="map-pin" size="1.1rem" /></span><span class="tt">{site.street}<br />{site.city}</span>
            </a></address></li>
          </ul>
        </div>

        <div class="card liquid">
          <h2><span class="disc"><Icon name="users" size="1.1rem" stroke={2} /></span>Urmăriți-ne</h2>
          <ul class="tiles">
            {site.socials.map((x) => (
              <li><a class="tile soc" href={x.href} target="_blank" rel="noopener">
                <span class="soc-ic"><Icon name={x.icon} size="1.35rem" stroke={1.9} /></span>
                <span class="soc-t"><b>{x.name}</b><small>{x.handle}</small></span>
                <span class="soc-go"><Icon name="arrow" size="1rem" stroke={2} /></span>
              </a></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="bottom">
        <p>© {year} {site.legal}</p>
        <ul>{LEGAL.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    </div>
  </Section>
</footer>

<style>
  ul { list-style: none; margin: 0; padding: 0; }

  /* one full screen; the top padding keeps the head clear of the floating header */
  .site-footer :global(.foot) { min-height: 100vh; min-height: 100svh; display: flex; padding-top: 3rem; padding-bottom: 1.3rem; }
  .site-footer :global(.foot > .section-inner) { flex: 1; display: flex; }
  .frame { flex: 1; display: flex; flex-direction: column; gap: 1.6rem; width: 100%; max-width: var(--container-page); margin: 0 auto; }

  .head { display: grid; justify-items: center; text-align: center; }
  .brand { display: inline-flex; align-items: baseline; gap: 0.55rem; line-height: 1; color: var(--color-white); text-decoration: none; }
  .brand-name { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; }
  .brand-sub { font-size: 0.95rem; font-weight: 500; color: var(--color-sky-300); }
  .lead { margin: 0.5rem 0 1.1rem; color: var(--ink-on-dark-soft); }
  .cta { display: flex; gap: 0.8rem; flex-wrap: wrap; justify-content: center; }
  .row { display: flex; align-items: center; justify-content: center; gap: 1.2rem; flex-wrap: wrap; }
  .sep { width: 1px; height: 2rem; background: rgb(255 255 255 / 0.18); }
  .links ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 0.5rem; }
  .links a {
    display: inline-flex; align-items: center; min-height: max(36px, 2.3rem); padding: 0 1rem; border-radius: var(--radius-pill);
    color: var(--color-white); text-decoration: none; font-weight: 500; font-size: 0.92rem;
    background: rgb(169 203 238 / 0.1); box-shadow: inset 0 0 0 1px rgb(169 203 238 / 0.22);
    transition: background-color 200ms var(--ease-out), color 200ms var(--ease-out);
  }

  /* cards take all the height that is left */
  .cards { flex: 1; display: grid; grid-template-columns: 1fr 2.1fr 1fr 1fr; gap: 1.1rem; min-height: 0; }
  .card {
    display: flex; flex-direction: column; padding: 1.1rem 1.15rem 1.15rem; border-radius: var(--radius-lg); font-size: 1.04rem;
    --lg-fill: rgb(169 203 238 / 0.12); --lg-rim: rgb(169 203 238 / 0.6); --lg-edge: rgb(169 203 238 / 0.22);
    --lg-shadow: 0 1.4rem 2.6rem -1.4rem rgb(0 0 0 / 0.55);
  }
  h2 { display: flex; align-items: center; justify-content: center; gap: 0.6rem; margin: 0 0 0.9rem; font-size: 1.2rem; font-weight: 600; color: var(--color-orange); }
  .disc { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--color-orange); color: var(--color-navy-900);
    box-shadow: 0 0.6rem 1.4rem -0.6rem rgb(253 158 1 / 0.7), inset 0 1px 0 rgb(255 255 255 / 0.6); }

  /* the darker tiles: rows stretch so every card is full */
  .tiles { flex: 1; display: grid; grid-auto-rows: 1fr; gap: 0.45rem; }
  .tiles.two { grid-template-columns: 1fr 1fr; }
  .tiles > li { display: flex; min-height: 0; }
  .addr-wrap { display: flex; flex: 1; font-style: normal; }
  .tile {
    flex: 1; display: flex; align-items: center; gap: 0.65rem; padding: 0.45rem 0.75rem; border-radius: var(--radius-md);
    background: rgb(10 20 38 / 0.42); box-shadow: inset 0 0 0 1px rgb(169 203 238 / 0.14), inset 0 1px 0 rgb(255 255 255 / 0.06);
    color: var(--color-white); text-decoration: none; line-height: 1.3;
    transition: background-color 200ms var(--ease-out), color 200ms var(--ease-out);
  }
  .tile.col { flex-direction: column; justify-content: center; gap: 0.15rem; text-align: center; }
  .tile.all { justify-content: center; gap: 0.45rem; font-weight: 600; color: var(--color-sky-300); background: rgb(10 20 38 / 0.22); }
  .svc-card .tt { font-weight: 500; }
  .svc-card .tile.all { color: var(--color-orange); }
  .days { font-size: 0.95rem; }

  /* social tiles: centred, big icon, the full handle, a small arrow that it opens the profile */
  .tile.soc { position: relative; flex-direction: column; justify-content: center; gap: 0.35rem; text-align: center; padding: 0.6rem 0.7rem; }
  .soc-ic { display: grid; place-items: center; width: 2.9rem; height: 2.9rem; border-radius: 50%;
    background: linear-gradient(145deg, var(--color-sky-300), var(--color-sky-500)); color: var(--color-navy-900);
    box-shadow: 0 0.5rem 1.2rem -0.5rem rgb(94 147 214 / 0.8), inset 0 1px 0 rgb(255 255 255 / 0.6); }
  .soc-t { display: grid; gap: 0.1rem; }
  .soc-t b { font-weight: 600; color: var(--color-orange); }
  .soc-t small { font-size: 0.78rem; color: var(--ink-on-dark-soft); overflow-wrap: anywhere; }
  .soc-go { position: absolute; top: 0.6rem; right: 0.7rem; color: var(--color-sky-300); opacity: 0.7; transform: rotate(-45deg); }
  .ti { display: grid; place-items: center; flex: none; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: rgb(253 158 1 / 0.16); color: var(--color-orange); }
  .ti.orange { color: var(--color-orange); background: rgb(253 158 1 / 0.14); }
  .ti.sky { background: var(--color-sky-300); color: var(--color-navy-900); }
  .num { display: grid; place-items: center; flex: none; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: rgb(253 158 1 / 0.16);
    color: var(--color-orange); font-size: 0.9rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .tt { display: grid; gap: 0.1rem; min-width: 0; }
  .tt b { font-weight: 600; }
  .tt small { font-size: 0.74rem; color: var(--color-sky-300); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .days { color: var(--ink-on-dark-soft); }
  .time { font-size: 1.45rem; font-weight: 700; color: var(--color-orange); font-variant-numeric: tabular-nums; }

  .bottom {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.6rem 2rem;
    padding-top: 1.1rem; border-top: 1px solid rgb(255 255 255 / 0.12); font-size: var(--text-small); color: var(--ink-on-dark-soft);
  }
  .bottom p { margin: 0; }
  .bottom ul { display: flex; gap: 1.6rem; }
  .bottom a { color: var(--ink-on-dark-soft); text-decoration: none; }

  @media (hover: hover) and (pointer: fine) {
    .links a:hover { background: var(--color-orange); color: var(--color-navy-900); }
    a.tile:hover { background: var(--color-orange); color: var(--color-navy-900); }
    a.tile:hover .ti, a.tile:hover .num { background: rgb(22 36 61 / 0.15); color: var(--color-navy-900); }
    a.tile:hover small, a.tile:hover .soc-t b, a.tile:hover .soc-go { color: var(--color-navy-900); }
    a.tile:hover .soc-ic { background: var(--color-navy-900); color: var(--color-orange); }
    .bottom a:hover { color: var(--color-orange); }
  }

  /* phone: plain stack for now (to be designed with Cata) */
  @media (max-width: 820px) {
    .site-footer :global(.foot) { min-height: 0; padding-top: 5.5rem; padding-bottom: calc(1.6rem + env(safe-area-inset-bottom, 0px)); }
    .cta { flex-direction: column; width: 100%; }
    .sep { display: none; }
    .cards { grid-template-columns: 1fr; }
    .tiles { grid-auto-rows: auto; }
    .tile { min-height: 3rem; }
    .bottom { flex-direction: column; text-align: center; }
    .bottom ul { flex-direction: column; gap: 0.4rem; align-items: center; }
  }
</style>
