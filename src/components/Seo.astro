---
// Per-page <head> SEO tags. Skeleton only: the full version (OG image, JSON-LD @graph with
// MedicalClinic + Physician + BreadcrumbList + per-page-type nodes) is task S5 in PLAN.md.
import { SITE_URL, SITE_NAME } from '../consts';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
---
<title>{title}</title>
{description && <meta name="description" content={description} />}
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
<link rel="canonical" href={canonical} />
<meta property="og:locale" content="ro_RO" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
