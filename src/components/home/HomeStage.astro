---
/**
 * The home page body (index.astro, also previewed at /dev/d/): every section inside the pinned stage,
 * with a different scroll transition at each boundary (stage.ts), paged one gesture = one section.
 * Order (Cata, 25 Nov 2026; video dropped from home 27 Nov, it goes to the voucher pages): Hero → Servicii →
 * Vouchere → Echipa → Recomandări → Program și locație.
 * Copy is only what FACTS already says; headings are drafts (D4 writes the copy; the Servicii intro waits for it).
 */
import Section from '../Section.astro';
import Hero from '../home/Hero.astro';
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { Image } from 'astro:assets';
import { site } from '../../data/site';
import VoucherGallery from '../home/VoucherGallery.astro';

const services = [
  { icon: 'stethoscope', t: 'Medicină de familie', d: 'Adulți și copii: consultații, controale periodice și prevenție.', href: '/medicina-de-familie/', c: '#7FB0EC' },
  { icon: 'movement', t: 'Kinetoterapie și recuperare', d: 'Recuperare medicală, la clinică și la domiciliu.', href: '/kinetoterapie/', c: '#FFB547' },
  { icon: 'sparkles', t: 'Terapii beauty', d: 'Pentru corp și față, fără ace și fără bisturiu.', href: '/terapii-beauty/', c: '#FF9C7E' },
] as const;
/* one colour per recommendation (brand sky / orange / peach tones; no mauve outside gradients) */
const recColors = ['#5E93D6', '#F5A02A', '#FF8F70', '#7FB8E8', '#FFC861'];
const extra = ['Ecografie', 'EKG', 'Holter TA', 'Osteodensitometrie'];
/* photos: M/staff, unretouched (staff consent confirmed by Cata, 27 Nov 2026).
   One colour per person; `pos`/`zoom` frame the face (Dr. Baiduca's photo is a wide desk shot). */
import pTeusdea from '../../assets/staff/dr-teusdea-alina.jpg';
import pBaiduca from '../../assets/staff/dr-baiduca-alexandru-echipa.jpg';   // standing, cropped from the team photo (Cata)
import pBodogai from '../../assets/staff/bodogai-anca.jpg';
import pGelnic from '../../assets/staff/gelnic-corina-maria.jpg';
const staff = [
  { n: 'Dr. Teușdea Alina', r: 'Medic primar Medicină de familie · Competență în ecografie generală', img: pTeusdea, c: '#5E93D6', pos: '50% 30%', zoom: 1 },
  { n: 'Dr. Baiduca Alexandru', r: 'Medic specialist Medicină fizică și de reabilitare', img: pBaiduca, c: '#F5A02A', pos: '50% 30%', zoom: 1 },
  { n: 'Bodogai Anca', r: 'Fiziokinetoterapeut · Kinetoterapie la clinică și la domiciliu', img: pBodogai, c: '#FF8F70', pos: '50% 30%', zoom: 1 },
  { n: 'Gelnic Corina Maria', r: 'Asistent medical generalist · Balneofiziokinetoterapeut', img: pGelnic, c: '#E58FB8', pos: '50% 30%', zoom: 1 },
];
const quotes = [
  'Prevenția nu este pentru cei bolnavi, ci pentru cei care vor să rămână sănătoși, la orice vârstă.',
  'Nu așteptați să vă doară ca să veniți la control.',
  'Peste 40 de ani? Este momentul potrivit pentru verificarea tensiunii, glicemiei și colesterolului.',
  'Vă cunoaștem, vă urmărim în timp și vă coordonăm îngrijirea.',
  'Nu știți dacă aveți nevoie de specialist sau de analize? Începeți cu medicul de familie.',
];
---
<div data-stage>
  <div class="scene"><Hero /></div>

  <!-- 1 → 2: zoom out, slide sideways, zoom in (Cata's idea) -->
  <div class="scene" data-tx="zoomslide">
    <Section ground="navy" seed={202} aria-labelledby="h-serv">
      <SectionHead eyebrow="Servicii" title="Cele trei servicii ale clinicii" size="h1" />
      <div class="svc">
        {services.map((s) => (
          <a class="svc-card liquid" href={s.href} style={`--c:${s.c}`}>
            <span class="svc-ic"><Icon name={s.icon} size="2.6rem" stroke={1.8} /></span>
            <h3>{s.t}</h3><p>{s.d}</p>
          </a>
        ))}
      </div>
      <p class="extra">Servicii suplimentare: {extra.join(' · ')}</p>
    </Section>
  </div>

  <!-- 2 → 3: a circle opens on the voucher gallery (real fronts, accordion) -->
  <div class="scene" data-tx="iris">
    <Section ground="peach" seed={203}>
      <SectionHead eyebrow="Vouchere" title="Pentru dumneavoastră sau cadou" />
      <VoucherGallery />
    </Section>
  </div>

  <!-- 3 → 4: vertical blinds -->
  <div class="scene" data-tx="blinds">
    <Section ground="light" seed={205}>
      <SectionHead eyebrow="Echipa noastră" title="Medici și terapeuți specializați" />
      <div class="team">
        {staff.map((p) => (
          <div class="slot">
            <article class="person liquid" style={`--c:${p.c};--pos:${p.pos};--zoom:${p.zoom}`}>
              <div class="ph"><Image src={p.img} alt={p.n} widths={[320, 560, 900, 1400]} sizes={`(max-width: 820px) calc(45vw * ${p.zoom}), calc(18rem * ${p.zoom})`} /></div>
              <h3>{p.n}</h3><span class="bar" aria-hidden="true"></span><p>{p.r}</p>
            </article>
          </div>
        ))}
      </div>
      <div class="center"><Button variant="secondary" href="/despre-noi/" iconEnd="arrow">Despre noi</Button></div>
    </Section>
  </div>

  <!-- 4 → 5: the stage turns like a cube; the quotes then step through -->
  <div class="scene" data-tx="cube">
    <Section ground="navy" seed={206}>
      <SectionHead eyebrow="Recomandările noastre" title="Pe scurt, de la medicul de familie" />
      <div class="rec" data-rec>
        <div class="rec-wash" aria-hidden="true">{quotes.map((_, i) => <i style={`--c:${recColors[i]}`}></i>)}</div>
        <div class="rec-cards">
          {quotes.map((q, i) => <blockquote class="q" style={`--c:${recColors[i]}`}><span class="q-n">{i + 1} / {quotes.length}</span><p>„{q}”</p></blockquote>)}
        </div>
        <button type="button" class="rec-skip" data-down="Treceți peste recomandări" data-up="Înapoi, peste recomandări">
          <span class="lbl">Treceți peste recomandări</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <div class="center"><Button variant="call" /></div>
    </Section>
  </div>

  <!-- 5 → 6: a diagonal wipe sweeps across -->
  <div class="scene" data-tx="diagonal">
    <Section ground="peach" seed={207}>
      <SectionHead eyebrow="Program și locație" title="Vă așteptăm la clinică" />
      <div class="visit">
        <div class="hours liquid">
          <h3 class="h-title"><Icon name="clock" size="1.6rem" stroke={1.8} />Program</h3>
          <!-- a drawn heartbeat line (the hero's line-art style) -->
          <svg class="pulse" viewBox="0 0 220 28" aria-hidden="true"><path d="M2 14h70l8-10 10 22 9-18 6 6h26c4 0 6-6 10-6s6 6 10 6h67" /></svg>
          <div class="h-rows">
            {site.hours.map((h, i) => (
              <p><span class="h-ic"><Icon name={i === 0 ? 'sun' : 'sunset'} size="1.4rem" stroke={1.8} /></span><strong>{h.days}</strong><span class="h-time">{h.time}</span></p>
            ))}
          </div>
          <p class="note"><Icon name="calendar" size="1.2rem" stroke={1.8} />{site.hoursNote}</p>
          <div class="h-contact">
            <a href={site.mapsHref}><Icon name="map-pin" size="1.25rem" stroke={1.8} /><span>{site.street}, {site.city}</span></a>
            <a href={site.phoneHref}><Icon name="phone" size="1.25rem" stroke={1.8} /><span>{site.phone}</span></a>
          </div>
        </div>
        <!-- the live map is visual only (wheel over an iframe would stop the section paging); the whole card opens Google Maps -->
        <a class="map liquid" href={site.mapsHref} target="_blank" rel="noopener" aria-label={`Deschideți în Google Maps: ${site.street}, ${site.city}`}>
          <iframe title="Hartă: Centrul Medical Ecomed" data-src="https://www.google.com/maps?q=Str.+Nicolae+Jiga+9,+Oradea&z=16&output=embed" referrerpolicy="no-referrer-when-downgrade" tabindex="-1"></iframe>
          <span class="map-tag"><Icon name="map-pin" size="1.1rem" stroke={2} />Deschideți în Google Maps</span>
        </a>
      </div>
      <div class="center btns"><Button variant="call" size="lg" /><Button variant="secondary" size="lg" href="/contact/" iconEnd="arrow">Contact</Button></div>
    </Section>
  </div>
</div>

<script>
  // the Google map loads quietly once the page is idle, so it is ready before anyone reaches it
  const loadMap = () => document.querySelectorAll<HTMLIFrameElement>('iframe[data-src]').forEach((f) => { f.src = f.dataset.src!; f.removeAttribute('data-src'); });
  addEventListener('load', () => setTimeout(() => ('requestIdleCallback' in window ? requestIdleCallback(loadMap, { timeout: 4000 }) : loadMap()), 2500), { once: true });
</script>

<style>
  .center { display: flex; justify-content: center; margin-top: 1.8rem; }
  .btns { gap: 0.8rem; flex-wrap: wrap; }
  h3 { margin: 0; font-size: var(--text-h3, 1.4rem); font-weight: 600; }
  .svc, .team, .visit, .rec, .hview { max-width: var(--container-page); margin: 1.8rem auto 0; }

  .svc { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; margin-top: 2.4rem; }
  .svc-card {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1rem; padding: 2.4rem 2rem 2.6rem;
    border-radius: 1.8rem; color: inherit; text-decoration: none;
    --lg-fill: color-mix(in srgb, var(--c) 24%, rgb(255 255 255 / 0.06));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 55%, transparent), 0 1.4rem 3rem -1.6rem color-mix(in srgb, var(--c) 70%, black);
  }
  .svc-ic {
    display: grid; place-items: center; width: 5.4rem; height: 5.4rem; border-radius: 50%;
    background: var(--c); color: var(--color-navy-900);
    box-shadow: 0 0.9rem 2rem -0.8rem var(--c), inset 0 1px 0 rgb(255 255 255 / 0.65);
  }
  .svc-card h3 { font-size: 1.9rem; line-height: 1.2; }
  .svc-card p { margin: 0; font-size: 1.2rem; line-height: 1.5; color: var(--ctx-muted); max-width: 22rem; }
  .person p, .vg p { margin: 0; color: var(--ctx-muted); }
  .extra { text-align: center; margin: 2rem 0 0; color: var(--ctx-muted); font-size: 1.1rem; }

  .hview { overflow: visible; max-width: none; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
  .htrack { display: flex; gap: 1.4rem; width: max-content; }
  .vg { width: 22rem; display: grid; gap: 0.6rem; padding: 1.2rem 1.2rem 1.6rem; border-radius: 1.6rem; color: inherit; text-decoration: none; }
  .vg-front { aspect-ratio: 3 / 2; border-radius: 1rem; display: grid; place-items: center; font-size: 0.85rem; color: var(--ctx-muted); background: rgb(255 255 255 / 0.45); border: 1px dashed rgb(22 36 61 / 0.3); }
  .vg-n { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; }


  .team { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
  /* each person has a colour: tinted card, coloured rim, a short bar under the name; text centred */
  .person {
    padding: 1rem 1rem 1.5rem; border-radius: 1.6rem; display: flex; flex-direction: column; align-items: center; gap: 0.55rem; text-align: center;
    --lg-fill: color-mix(in srgb, var(--c) 18%, rgb(255 255 255 / 0.45));
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--c) 55%, transparent), 0 1.4rem 2.8rem -1.6rem color-mix(in srgb, var(--c) 75%, rgb(22 36 61));
  }
  .ph { width: 100%; aspect-ratio: 4 / 5; border-radius: 1.1rem; overflow: hidden; margin-bottom: 0.4rem;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 70%, white), 0 0.8rem 1.6rem -1rem color-mix(in srgb, var(--c) 80%, black); }
  /* hover (mouse): a slight lift and zoom in place */
  .slot { display: flex; }
  .slot > .person { flex: 1; }
  .person { transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1); }
  @media (hover: hover) and (pointer: fine) { .person:hover { transform: translateY(-0.3rem) scale(1.03); } }
  .ph :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); transform: scale(var(--zoom)); transform-origin: var(--pos); }
  .person h3 { font-size: 1.35rem; line-height: 1.2; }
  .person .bar { width: 2.4rem; height: 3px; border-radius: 3px; background: var(--c); }
  .person p { font-size: 0.98rem; line-height: 1.45; text-wrap: balance; }

  /* recommendations: one card at a time, each growing out of its point on the line below */
  .rec { position: relative; max-width: none; }
  .rec-wash { position: absolute; inset: -40vh -10vw; pointer-events: none; z-index: 0; }
  .rec-wash i { position: absolute; inset: 0; opacity: 0; background: radial-gradient(42% 46% at 50% 45%, color-mix(in srgb, var(--c) 34%, transparent), transparent 70%); }
  .rec-wash i:first-child { opacity: 1; }
  .rec-cards { position: relative; z-index: 3; display: grid; justify-items: center; max-width: 44rem; margin: 0 auto; }
  .q {
    grid-area: 1 / 1; width: 100%; margin: 0; padding: 2.4rem 3rem 2.6rem; border-radius: 2rem; text-align: center;
    background: color-mix(in srgb, var(--c) 26%, rgb(255 255 255 / 0.06));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 60%, transparent), 0 1.6rem 3.4rem -1.8rem color-mix(in srgb, var(--c) 80%, black);
    transform-origin: 50% 100%; backface-visibility: hidden;
  }
  .q-n { display: block; margin-bottom: 0.8rem; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; color: var(--c); }
  .q p { margin: 0; font-size: var(--text-h2); line-height: 1.25; font-weight: 500; text-wrap: balance; }
  /* skip: down (arrived from above) or up (arrived from below) */
  .rec-skip { position: relative; display: flex; margin: 1.4rem auto 0; width: max-content; z-index: 2; align-items: center; gap: 0.5rem;
    padding: 0.55rem 0.95rem; border: 0; border-radius: 999px; font: inherit; font-size: 0.9rem; font-weight: 500; cursor: pointer;
    color: rgb(255 255 255 / 0.82); background: rgb(255 255 255 / 0.08); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
    transition: background-color 180ms, color 180ms, transform 120ms; touch-action: manipulation; }
  .rec-skip svg { width: 1.05rem; height: 1.05rem; transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .rec-skip.up svg { transform: rotate(180deg); }
  .rec-skip:active { transform: scale(0.97); }
  .rec-skip:focus-visible { outline: 2px solid var(--color-sky-300, #9cc8f0); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) { .rec-skip:hover { background: rgb(255 255 255 / 0.16); color: #fff; } }

  .visit { display: grid; grid-template-columns: 1fr 1.25fr; gap: 1.4rem; max-width: 72rem; }
  /* left: everything centred; sun / sunset for the morning and afternoon hours, a drawn heartbeat under the title */
  .hours { padding: 2rem 2.2rem; border-radius: 1.6rem; display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 1rem; text-align: center; font-size: 1.25rem; }
  .h-title { display: flex; align-items: center; justify-content: center; gap: 0.6rem; font-size: 1.7rem; }
  .h-title :global(.icon), .h-contact :global(.icon) { color: var(--color-orange-ink, #B86200); }
  .pulse { width: 13rem; height: 1.7rem; margin-top: -0.4rem; }
  .pulse path { fill: none; stroke: var(--color-orange); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .h-rows { display: flex; justify-content: center; gap: 1rem; width: 100%; }
  .h-rows p { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 0.35rem; margin: 0; padding: 1rem 0.8rem; border-radius: 1.2rem; background: rgb(255 255 255 / 0.35); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.6); }
  .h-ic { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: rgb(253 158 1 / 0.18); color: var(--color-orange-ink, #B86200); margin-bottom: 0.2rem; }
  .h-rows p:last-child .h-ic { background: rgb(94 147 214 / 0.18); color: #3E6FAE; }
  .h-rows strong { font-size: 1.05rem; }
  .h-time { font-size: 1.45rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .hours .note { display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin: 0; color: var(--ctx-muted); font-size: 1.1rem; }
  .h-contact { display: grid; justify-items: center; gap: 0.55rem; width: 100%; padding-top: 1rem; border-top: 1px solid rgb(22 36 61 / 0.12); }
  .h-contact a { display: inline-flex; align-items: center; gap: 0.55rem; color: inherit; text-decoration: none; font-size: 1.1rem; font-weight: 500; }
  /* right: the live Google map */
  .map { position: relative; min-height: 24rem; border-radius: 1.6rem; overflow: hidden; color: inherit; text-decoration: none; padding: 0.5rem; }
  .map iframe { width: 100%; height: 100%; min-height: 23rem; border: 0; border-radius: 1.2rem; pointer-events: none; display: block; background: #E8EEF4; }
  /* the iframe shows only once the scene has landed (no live map on a moving layer); fades in */
  :global(.stage-on) .map iframe { visibility: hidden; opacity: 0; transition: opacity 400ms ease 120ms, visibility 0s linear 520ms; }
  :global(.stage-on .settled) .map iframe { visibility: visible; opacity: 1; transition: opacity 400ms ease 120ms, visibility 0s; }
  .map { background: #E8EEF4; }
  .map-tag { position: absolute; left: 1.2rem; bottom: 1.2rem; display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.55rem 0.95rem; border-radius: 999px;
    background: var(--color-navy-900); color: #fff; font-size: 0.95rem; font-weight: 500; box-shadow: 0 0.6rem 1.4rem -0.6rem rgb(22 36 61 / 0.6); }
  .map-tag :global(.icon) { color: var(--color-orange); }
  @media (hover: hover) and (pointer: fine) { .map:hover .map-tag { background: var(--color-orange); color: var(--color-navy-900); } .map:hover .map-tag :global(.icon) { color: var(--color-navy-900); } .h-contact a:hover span { text-decoration: underline; } }

  @media (max-width: 820px) {
    .svc, .team, .visit { grid-template-columns: 1fr; }
    .team { grid-template-columns: 1fr 1fr; }
    .vg { width: 78vw; }
    .q { padding: 1.6rem; }
    .q p { font-size: 1.4rem; }
  }
</style>
