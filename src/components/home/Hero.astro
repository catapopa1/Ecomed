---
/**
 * Home hero: copy (centred) on the left, the drawing on the right.
 * The drawing is the REAL voucher 16 art (M/desene/desen_voucher_16.png, the face), mirrored to look left.
 * The art was traced into true vector lines at build time (scripts/hero-strokes.mjs → src/data/heroStrokes.json),
 * so it is crisp at any size. It "draws itself" once on load (dash transition per line): every line draws
 * from its outer end inwards, started by a front closing in from the four corners into the middle.
 * No JS / reduced motion: the drawing is simply there, complete.
 * Promo pill slot: none until there is a real promo (TODO (ask Cata)).
 */
import Section from '../Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';
import art from '../../data/heroStrokes.json';

const { w: W, h: H } = art;
const st = (s: { delay: number; dur: number }) => `--d:${s.delay}s;--t:${s.dur}s`;
const orange = art.paths.filter((p) => p.o);
---
<Section ground="light" seed={101} class="hero" aria-labelledby="hero-h1">
  <div class="hero-grid">
    <div class="copy">
      <p class="chip liquid"><Icon name="map-pin" size="1rem" stroke={2} /> Oradea · Județul Bihor</p>
      <h1 id="hero-h1">Medic de familie și recuperare medicală <span class="accent">în Oradea</span></h1>
      <p class="lead">Medicină de familie, kinetoterapie și terapii beauty, la {site.name}.</p>
      <div class="btns">
        <Button variant="call" size="lg" />
        <Button variant="secondary" size="lg" href="/servicii/" iconEnd="arrow">Servicii</Button>
      </div>
      <p class="note">{site.hoursNote}</p>
    </div>

    <div class="art" id="hero-art" aria-hidden="true">
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet">
        <defs>
          <filter id="hero-glow" x="-5%" y="-5%" width="110%" height="110%"><feGaussianBlur stdDeviation="3.2" /></filter>
        </defs>
        {/* the orange lines' soft glow: blurred copies that draw along with them */}
        <g class="glow" filter="url(#hero-glow)">
          {orange.map((p) => <path class="a-d" pathLength="1" d={p.d} stroke={p.col} stroke-width={p.w * 1.8} style={st(p)} />)}
        </g>
        <g>
          {art.paths.map((p) => <path class="a-d" pathLength="1" d={p.d} stroke={p.col} stroke-width={p.w} style={st(p)} />)}
        </g>
      </svg>
      {/* hide before first paint so the draw starts from nothing; skipped with reduced motion (and without JS) */}
      <script is:inline>
        (function () {
          // the home page always opens on the hero (the stage pages section by section; a restored
          // in-between position would also hide the drawing)
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
          scrollTo(0, 0);
          var a = document.getElementById('hero-art');
          if (!a || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          a.classList.add('pre');
          // start once the page has loaded and the motion engine is built (busy main thread = the draw
          // would finish unseen); fallback after 3 s
          var started = false, loaded = document.readyState === 'complete', ready = document.documentElement.classList.contains('motion-ready');
          function go() {
            if (started) return; started = true;
            requestAnimationFrame(function () { requestAnimationFrame(function () { a.classList.remove('pre'); a.classList.add('go'); }); });
          }
          function check() { if (loaded && ready) setTimeout(go, 120); }
          addEventListener('load', function () { loaded = true; check(); }, { once: true });
          addEventListener('motion-ready', function () { ready = true; check(); }, { once: true });
          setTimeout(go, 3000);
          check();
        })();
      </script>
    </div>
  </div>
</Section>

<style>
  :global(.hero) { min-height: 100vh; min-height: 100svh; display: grid; align-content: center; }
  /* the hero is exactly one screen on every desktop: the drawing is sized by the screen height too */
  :global(.hero.section) { padding-top: 0; padding-bottom: 0; }
  .hero-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 2rem;
    max-width: var(--container-page); margin: 0 auto; padding: 6rem 0 1rem;
  }

  /* the copy is centred in its half (Cata) */
  .copy { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .chip {
    display: inline-flex; align-items: center; gap: 0.5rem; margin: 0; padding: 0.5rem 1rem;
    border-radius: var(--radius-pill); font-size: var(--text-small); font-weight: var(--font-weight-medium);
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ctx-eyebrow);
    --lg-fill: rgb(255 255 255 / 0.5);
  }
  .chip :global(svg) { color: var(--color-sky-ink); }
  h1 {
    margin: 1.4rem 0 0; font-size: var(--text-display); line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing); font-weight: 700; color: var(--color-navy-900); text-wrap: balance;
  }
  .accent { color: var(--color-sky-ink); }
  .lead { margin: 1.3rem 0 0; max-width: 32rem; font-size: var(--text-lead); line-height: var(--text-lead--line-height); color: var(--ctx-muted); text-wrap: balance; }
  .btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; margin-top: 2.2rem; }
  .note { margin: 1.1rem 0 0; font-size: var(--text-small); color: var(--ctx-muted); }

  /* ── drawing ── */
  .art { position: relative; width: min(100%, calc((100svh - 8rem) * 0.842)); justify-self: center; aspect-ratio: 1179 / 1400;
    /* only a thin soft edge where the art's circles and band run off the drawing, so all of it shows */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent), linear-gradient(transparent, #000 2.5%, #000 97.5%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent), linear-gradient(transparent, #000 2.5%, #000 97.5%, transparent);
    mask-composite: intersect; }
  .art svg { position: absolute; inset: 0; width: 100%; height: 100%; stroke-linecap: round; stroke-linejoin: round; overflow: visible; }

  /* the lines themselves (colour and width per line come from the art) */
  .a-d { fill: none; stroke-dasharray: 1 2; stroke-dashoffset: 0; }
  .glow { opacity: 0.3; }

  /* draw-in: class selectors only (Chrome won't restyle SVG children matched by [pathLength]).
     The hidden offset sits just past 1 so a round cap can't leave a dot at a line's start. */
  .art.pre .a-d { stroke-dashoffset: 1.02; transition: none; }
  .a-d { transition: stroke-dashoffset var(--t) var(--ease-draw) var(--d); }

  @media (prefers-reduced-motion: reduce) {
    .art .a-d { transition: none !important; }
  }

  /* ── phone: copy on top, the drawing under it, all on one screen ── */
  @media (max-width: 820px) {
    :global(.hero.section) { padding-top: 0; padding-bottom: 0; }
    .hero-grid { grid-template-columns: 1fr; gap: 0; padding-top: 6.4rem; }
    .chip { font-size: 0.78rem; padding: 0.4rem 0.85rem; }
    h1 { font-size: 2.2rem; margin-top: 0.9rem; }
    .lead { font-size: 1rem; line-height: 1.5; margin-top: 0.7rem; }
    .btns { flex-direction: column; align-self: stretch; gap: 0.55rem; margin-top: 1.2rem; }
    .btns :global(.btn) { width: 100%; min-height: max(48px, 3.2rem); }
    .note { display: none; }
    .art { width: min(100%, 30svh); margin: 0.4rem auto 0; }
  }
</style>
