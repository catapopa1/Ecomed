---
/**
 * Home hero (B): copy (centred) on the left, the voucher-style line drawing on the right.
 * The drawing draws itself once on load (popa-insolventa method: pathLength="1" + a dash transition),
 * slowly and in order: the wave band and circles, the ECG pen line, the stethoscope (ear tubes draw the
 * heart, then the tube runs to the chest piece), the chest piece, the ripples, the glow and plus signs.
 * Then it rests and only breathes. No video here (Cata: the video goes lower on the page).
 * No JS / reduced motion: the drawing is simply there, complete. Geometry: src/data/heroArt.ts.
 * Promo pill slot: none until there is a real promo (TODO (ask Cata)).
 */
import Section from '../Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';
import { W, H, band, bandOrange, pulse, tubes, yoke, ears, chest, ripples, glow, pluses, circles } from '../../data/heroArt';
const tubeList = [
  { t: tubes.left, k: 'ear' }, { t: tubes.right, k: 'ear' }, { t: tubes.main, k: 'main' },
];
---
<Section ground="light" seed={101} class="hero" aria-labelledby="hero-h1">
  <div class="hero-grid">
    <div class="copy">
      <p class="chip liquid"><Icon name="map-pin" size="1rem" stroke={2} /> Oradea · Județul Bihor</p>
      <h1 id="hero-h1">Medic de familie și recuperare medicală <span class="accent">în Oradea</span></h1>
      <p class="lead">Medicină de familie, kinetoterapie și terapii beauty, la {site.name}.</p>
      <div class="btns">
        <Button variant="call" size="lg" />
        <Button variant="secondary" size="lg" href="/servicii/" iconEnd="arrow">Servicii</Button>
      </div>
      <p class="note">{site.hoursNote}</p>
    </div>

    <div class="art" id="hero-art" aria-hidden="true">
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet">
        <defs>
          <radialGradient id="hero-glow"><stop offset="0" stop-color="var(--color-orange-200)" stop-opacity=".95" /><stop offset=".5" stop-color="var(--color-sky-300)" stop-opacity=".45" /><stop offset="1" stop-color="var(--color-sky-300)" stop-opacity="0" /></radialGradient>
        </defs>
        <circle class="a-glow" cx={glow.cx} cy={glow.cy} r={glow.r} fill="url(#hero-glow)" />
        <g class="a-circles">
          {circles.map(([cx, cy, r, c], i) => (
            <g style={`--i:${i}`}>
              {c === 'o' && <circle class="a-d halo" pathLength="1" cx={cx} cy={cy} r={r} />}
              <circle class:list={['a-d', c === 'o' ? 'o' : 's']} pathLength="1" cx={cx} cy={cy} r={r} />
            </g>
          ))}
        </g>
        <g class="a-band">
          {band.map((d, i) => <path class="a-d" pathLength="1" d={d} style={`--i:${i}`} />)}
          <path class="a-d halo wide" pathLength="1" d={bandOrange} />
          <path class="a-d o wide" pathLength="1" d={bandOrange} />
        </g>
        <path class="a-d a-pulse" pathLength="1" d={pulse} />
        <g class="a-steth">
          {tubeList.map(({ t, k }) => (
            <g class={k}>
              <path class="a-d hi" pathLength="1" d={t.hi} />
              <path class="a-d ln" pathLength="1" d={t.a} />
              <path class="a-d ln" pathLength="1" d={t.b} />
            </g>
          ))}
          <rect class="a-d ln yk" pathLength="1" x={yoke.x} y={yoke.y} width={yoke.w} height={yoke.h} rx="5" />
          <g class="ears">{ears.map((d) => <path class="a-d ln" pathLength="1" d={d} />)}</g>
          <g class="chest">
            {chest.stem.map((d) => <path class="a-d ln" pathLength="1" d={d} />)}
            {chest.rings.map((d, i) => <path class:list={['a-d', i === 1 ? 's' : 'ln']} pathLength="1" d={d} style={`--i:${i}`} />)}
          </g>
        </g>
        <g class="a-rip">
          {ripples.map((d, i) => (
            <g style={`--i:${i}`}><path class="a-d halo" pathLength="1" d={d} /><path class="a-d o" pathLength="1" d={d} /></g>
          ))}
        </g>
        <g class="a-plus">{pluses.map((d, i) => <path class:list={['a-d', i % 2 ? 's' : 'o']} pathLength="1" d={d} style={`--i:${i}`} />)}</g>
      </svg>
      {/* hide before first paint so the draw starts from nothing; skipped with reduced motion (and without JS) */}
      <script is:inline>
        (function () {
          // the home page always opens on the hero (the stage pages section by section; a restored
          // in-between position would also hide the drawing)
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
          scrollTo(0, 0);
          var a = document.getElementById('hero-art');
          if (!a || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          a.classList.add('pre');
          // start once the page has loaded and the motion engine is built (busy main thread = the draw
          // would finish unseen); fallback after 3 s
          var started = false, loaded = document.readyState === 'complete', ready = document.documentElement.classList.contains('motion-ready');
          function go() {
            if (started) return; started = true;
            requestAnimationFrame(function () { requestAnimationFrame(function () { a.classList.remove('pre'); a.classList.add('go'); }); });
          }
          function check() { if (loaded && ready) setTimeout(go, 120); }
          addEventListener('load', function () { loaded = true; check(); }, { once: true });
          addEventListener('motion-ready', function () { ready = true; check(); }, { once: true });
          setTimeout(go, 3000);
          check();
        })();
      </script>
    </div>
  </div>
</Section>

<style>
  :global(.hero) { min-height: 100vh; min-height: 100svh; display: grid; align-content: center; }
  /* the hero is exactly one screen on every desktop: the drawing is sized by the screen height too */
  :global(.hero.section) { padding-top: 0; padding-bottom: 0; }
  .hero-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 2rem;
    max-width: var(--container-page); margin: 0 auto; padding: 6rem 0 1rem;
  }

  /* the copy is centred in its half (Cata) */
  .copy { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .chip {
    display: inline-flex; align-items: center; gap: 0.5rem; margin: 0; padding: 0.5rem 1rem;
    border-radius: var(--radius-pill); font-size: var(--text-small); font-weight: var(--font-weight-medium);
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ctx-eyebrow);
    --lg-fill: rgb(255 255 255 / 0.5);
  }
  .chip :global(svg) { color: var(--color-sky-ink); }
  h1 {
    margin: 1.4rem 0 0; font-size: var(--text-display); line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing); font-weight: 700; color: var(--color-navy-900); text-wrap: balance;
  }
  .accent { color: var(--color-sky-ink); }
  .lead { margin: 1.3rem 0 0; max-width: 32rem; font-size: var(--text-lead); line-height: var(--text-lead--line-height); color: var(--ctx-muted); text-wrap: balance; }
  .btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; margin-top: 2.2rem; }
  .note { margin: 1.1rem 0 0; font-size: var(--text-small); color: var(--ctx-muted); }

  /* ── drawing ── */
  .art { position: relative; width: min(100%, calc(100svh - 9rem)); justify-self: center; aspect-ratio: 1;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent); }
  .art svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke-linecap: round; stroke-linejoin: round; }

  .a-band .a-d { stroke: var(--color-sky-500); stroke-width: 0.7; opacity: 0.7; }
  .a-band .a-d:nth-child(3n) { opacity: 0.4; }
  .a-pulse { stroke: var(--color-navy); stroke-width: 2; stroke-linejoin: miter; stroke-miterlimit: 8; }
  .a-steth .ln { stroke: var(--color-navy); stroke-width: 1.7; }
  .a-steth .hi { stroke: var(--color-sky-500); stroke-width: 1; opacity: 0.8; }
  .a-d.o { stroke: var(--color-orange); stroke-width: 2; }
  .a-d.s { stroke: var(--color-sky-500); stroke-width: 1.6; }
  .a-d.halo { stroke: var(--color-sky-300); stroke-width: 6; opacity: 0.6; }
  .a-band .a-d.wide.o { stroke-width: 2.6; opacity: 1; }
  .a-band .a-d.wide.halo { stroke-width: 7.5; opacity: 0.55; }
  .a-plus .a-d { stroke-width: 2.2; }

  /* draw-in: class selectors only (Chrome won't restyle SVG children matched by [pathLength]) */
  .a-d { stroke-dasharray: 1 1; stroke-dashoffset: 0; }
  .a-glow { transform-box: fill-box; transform-origin: center; }
  .art.pre .a-d { stroke-dashoffset: 1; transition: none; }
  .art.pre .a-glow { opacity: 0; transform: scale(0.6); transition: none; }

  .a-band .a-d { transition: stroke-dashoffset 2.8s var(--ease-draw) calc(0.1s + var(--i, 0) * 0.05s); }
  .a-band .a-d.wide { transition-delay: 0.4s; transition-duration: 3s; }
  .a-circles .a-d { transition: stroke-dashoffset 1.8s var(--ease-draw) calc(0.5s + var(--i) * 0.12s); }
  .a-pulse { transition: stroke-dashoffset 3.2s var(--ease-draw) 0.7s; }
  .a-steth .ear .a-d { transition: stroke-dashoffset 2.6s var(--ease-draw) 1.4s; }
  .a-steth .ears .a-d { transition: stroke-dashoffset 0.7s var(--ease-draw) 1.2s; }
  .a-steth .yk { transition: stroke-dashoffset 0.5s var(--ease-draw) 3.6s; }
  .a-steth .main .a-d { transition: stroke-dashoffset 1.4s var(--ease-draw) 3.8s; }
  .a-steth .chest .a-d { transition: stroke-dashoffset 1.1s var(--ease-draw) calc(4.9s + var(--i, 0) * 0.18s); }
  .a-rip .a-d { transition: stroke-dashoffset 1s var(--ease-draw) calc(5.6s + var(--i) * 0.18s); }
  .a-plus .a-d { transition: stroke-dashoffset 0.6s var(--ease-draw) calc(5.9s + var(--i) * 0.15s); }
  .a-glow { transition: opacity 1.6s ease 3.6s, transform 1.6s var(--ease-drop) 3.6s; }

  /* resting: the glow breathes, the ripples pulse outwards, the circles float */
  .art.go .a-glow { animation: breathe 5s ease-in-out 5.4s infinite; }
  .art.go .a-rip g { animation: ripple 3.6s ease-in-out calc(7s + var(--i) * 0.35s) infinite; }
  .art.go .a-circles g { transform-box: view-box; animation: float 9s ease-in-out calc(var(--i) * -1.3s) infinite; }
  @keyframes breathe { 50% { opacity: 0.7; transform: scale(1.08); } }
  @keyframes ripple { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  @keyframes float { 50% { transform: translate(0, -6px); } }

  @media (prefers-reduced-motion: reduce) {
    .art .a-d, .a-glow { transition: none !important; }
    .art .a-glow, .art .a-rip g, .art .a-circles g { animation: none !important; }
  }

  /* ── phone: copy on top, the drawing under it, all on one screen ── */
  @media (max-width: 820px) {
    :global(.hero.section) { padding-top: 0; padding-bottom: 0; }
    .hero-grid { grid-template-columns: 1fr; gap: 0; padding-top: 6.4rem; }
    .chip { font-size: 0.78rem; padding: 0.4rem 0.85rem; }
    h1 { font-size: 2.2rem; margin-top: 0.9rem; }
    .lead { font-size: 1rem; line-height: 1.5; margin-top: 0.7rem; }
    .btns { flex-direction: column; align-self: stretch; gap: 0.55rem; margin-top: 1.2rem; }
    .btns :global(.btn) { width: 100%; min-height: max(48px, 3.2rem); }
    .note { display: none; }
    .art { width: min(100%, 32svh); margin: 0.4rem auto 0; }
    .a-pulse { stroke-width: 2.8; }
    .a-steth .ln { stroke-width: 2.3; }
    .a-band .a-d { stroke-width: 1; }
  }
</style>
